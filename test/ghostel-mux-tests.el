      (ghostel-mux-new-window)
      (ghostel-mux-split-right)
      (ghostel-mux-zoom)
      (let* ((target (ghostel-mux--current-window))
             (target-buffer (current-buffer)))
        (ghostel-mux-previous-window)
        (ghostel-mux-new-session "two")
        (ghostel-mux-split-right)
        ;; A foreign terminal on screen does not change the attached session.
        (let ((foreign (current-buffer)))
          (ghostel-mux "one")
          (set-window-buffer (selected-window) foreign)
          (set-buffer foreign))
        (let ((origin (ghostel-mux--current-window))
              (views (mapcar #'window-buffer (window-list)))
              (saved (ghostel-mux--window-state target)) cancelled)
          (cl-letf (((symbol-function 'consult--read)
                     (lambda (names &rest options)
                       (should (= 2 (length names)))
                       (should (cl-every (lambda (n) (string-prefix-p "one:" n)) names))
                       (should (equal (plist-get options :prompt) "Window (one): "))
                       (funcall (plist-get options :state) 'preview
                                (cl-find-if (lambda (n) (string-prefix-p "one:2 " n)) names))
                       (should (eq origin (ghostel-mux--current-window)))
                       (should (eq first (ghostel-mux--session-current one)))
                       (should (eq (selected-frame) (ghostel-mux--session-frame one)))
                       (should (= 1 (length (window-list))))
                       (should (get-buffer-window target-buffer))
                       (with-current-buffer target-buffer
                         (should-error (ghostel-mux-test--send "blocked") :type 'user-error))
                       (ghostel-mux--capture)
                       (should (eq saved (ghostel-mux--window-state target)))
                       (signal 'quit nil))))
            (condition-case nil (ghostel-mux-select-window) (quit (setq cancelled t))))
          (should cancelled)
          (should (eq origin (ghostel-mux--current-window)))
          (should (equal views (mapcar #'window-buffer (window-list))))
          (should (eq first (ghostel-mux--session-current one)))
          (should-not (frame-parameter nil 'ghostel-mux-preview)))))))

