;;; ghostel-mux-tests.el --- Integration tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'ghostel-mux)

(defun ghostel-mux-test--wait (predicate &optional timeout)
  (let ((end (+ (float-time) (or timeout 4))))
    (while (and (not (funcall predicate)) (< (float-time) end))
      (accept-process-output nil 0.025))
    (should (funcall predicate))))
(defun ghostel-mux-test--text (p)
  (with-current-buffer (ghostel-mux--pane-buffer p)
    (or (ghostel--copy-all-text ghostel--term) "")))
(defun ghostel-mux-test--send (s)
  (let ((ghostel-mux--input-source (current-buffer))) (ghostel-send-string s)))

(defmacro ghostel-mux-test--with (&rest body)
  (declare (indent 0) (debug t))
  `(save-window-excursion
     (let ((ghostel-mux--sessions nil)
           (ghostel-mux--serial 0)
           (ghostel-mux--session-counters (make-hash-table :test #'eq))
           (ghostel-mux-scrollback-bytes (* 128 1024))
           (ghostel-mux-log-directory (make-temp-file "mux-ert-" t))
           (ghostel-mux-log-output t)
           (ghostel-mux-confirm-kill nil)
           (ghostel-mux-directory temporary-file-directory)
           (ghostel-shell '("/bin/bash" "--noprofile" "--norc"))
           (ghostel-shell-integration nil)
           (ghostel-term "xterm-256color")
           (ghostel-query-before-killing nil))
       (set-frame-parameter nil 'ghostel-mux-session nil)
       (unwind-protect
           (progn ,@body)
         (let ((ghostel-mux--closing t))
           (dolist (p (ghostel-mux--all-panes))
             (when (buffer-live-p (ghostel-mux--pane-buffer p))
               (kill-buffer (ghostel-mux--pane-buffer p)))))
         (set-frame-parameter nil 'ghostel-mux-session nil)
         (set-frame-parameter nil 'ghostel-mux-return-state nil)
         (delete-directory ghostel-mux-log-directory t)))))

(ert-deftest mux-sessions-window-layouts-and-independent-terminals ()
  (ghostel-mux-test--with
    (let* ((s1 (ghostel-mux-new-session "one"))
           (w1 (ghostel-mux--current-window))
           (p1 ghostel-mux--pane))
      (ghostel-mux-split-right)
      (should (= 2 (length (window-list))))
      (should-not (eq p1 ghostel-mux--pane))
      (should (cl-every #'ghostel-mux--pane-live-p (ghostel-mux--window-panes w1)))
      (ghostel-mux-new-window)
      (should (= 1 (length (window-list))))
      (ghostel-mux-previous-window)
      (should (= 2 (length (window-list))))
      (let ((s2 (ghostel-mux-new-session "two")))
        (should (= 1 (length (window-list))))
        (ghostel-mux "one")
        (should (eq s1 (ghostel-mux--current-session)))
        (should (= 2 (length (window-list))))
        (should-not (eq s1 s2))
        (should (= 4 (length (ghostel-mux--all-panes))))))))

(ert-deftest mux-zoom-survives-session-switch-and-keeps-sync ()
  (ghostel-mux-test--with
    (ghostel-mux-new-session "one")
    (ghostel-mux-split-right)
    (ghostel-mux-split-below)
    (let ((w (ghostel-mux--current-window))
          (buffers (mapcar #'window-buffer (window-list))))
      (ghostel-mux-toggle-sync)
      (ghostel-mux-zoom)
      (should (= 1 (length (window-list))))
      (ghostel-mux-new-session "two")
      (ghostel-mux "one")
      (should (= 1 (length (window-list))))
      (should (ghostel-mux--window-sync w))
      (ghostel-mux-zoom)
      (should (= 3 (length (window-list))))
      (should (null (cl-set-difference buffers (mapcar #'window-buffer (window-list))))))))

(ert-deftest mux-broadcast-is-visible-only-and-resumes-after-unzoom ()
  (ghostel-mux-test--with
    (ghostel-mux-new-session "other")
    (let ((other ghostel-mux--pane))
      (ghostel-mux-new-session "one")
      (ghostel-mux-split-right)
      (let ((ps (copy-sequence (ghostel-mux--window-panes (ghostel-mux--current-window)))))
        (ghostel-mux-toggle-sync)
        (ghostel-mux-test--send "printf 'ONE_%s\\n' DELIVERY\n")
        (ghostel-mux-test--wait
         (lambda () (cl-every (lambda (p) (string-match-p "ONE_DELIVERY" (ghostel-mux-test--text p))) ps)))
        (dolist (p ps)
          (should (= 1 (cl-count-if (lambda (line) (string-match-p "ONE_DELIVERY" line))
                                    (split-string (ghostel-mux-test--text p) "\n")))))
        (should-not (string-match-p "ONE_DELIVERY" (ghostel-mux-test--text other)))
        (ghostel-mux-zoom)
        (should (string-match-p "SYNC PAUSED (LOCAL)" (ghostel-mux--status ghostel-mux--pane)))
        (ghostel-mux-test--send "printf 'SOLO_%s\\n' DELIVERY\n")
        (let ((active ghostel-mux--pane))
          (ghostel-mux-test--wait
           (lambda () (string-match-p "SOLO_DELIVERY" (ghostel-mux-test--text active))))
          (ghostel-mux-zoom)
          (ghostel-mux-test--send "printf 'AFTER_%s\\n' UNZOOM\n")
          (ghostel-mux-test--wait
           (lambda () (cl-every (lambda (p) (string-match-p "AFTER_UNZOOM" (ghostel-mux-test--text p))) ps)))
          (dolist (p (delq active (copy-sequence ps)))
            (should-not (string-match-p "SOLO_DELIVERY" (ghostel-mux-test--text p))))
          (should (string-match-p "SYNC:2" (ghostel-mux--status active))))))))

(ert-deftest mux-interactive-key-command-enters-broadcast-path ()
  (ghostel-mux-test--with
    (ghostel-mux-new-session "one")
    (ghostel-mux-split-right)
    (ghostel-mux-toggle-sync)
    (let ((seen nil))
      (cl-letf (((symbol-function 'ghostel--write-pty)
                 (lambda (term bytes) (push (list term bytes) seen)))
                ((symbol-function 'ghostel--encode-key)
                 (lambda (term key mods &optional _utf8)
                   (should (equal key "c"))
                   (should (equal mods "ctrl"))
                   (push (list term "\x03") seen) t)))
        (call-interactively #'ghostel-send-C-c)
        (should (= 2 (length seen)))
        (should (= 2 (length (delete-dups (mapcar #'car seen)))))
        (should (cl-every (lambda (entry) (equal (cadr entry) "\x03")) seen))
        ;; An automatic/programmatic send is local even with SYNC enabled.
        (setq seen nil)
        (ghostel-send-string "PRIVATE")
        (should (= 1 (length seen)))))))

(ert-deftest mux-encoder-fallback-does-not-double-broadcast ()
  (ghostel-mux-test--with
    (ghostel-mux-new-session "one")
    (ghostel-mux-split-right)
    (ghostel-mux-toggle-sync)
    (let ((seen nil) (encoded nil)
          (ghostel-mux--input-source (current-buffer)))
      (cl-letf (((symbol-function 'ghostel--encode-key)
                 (lambda (term &rest _) (push term encoded) nil))
                ((symbol-function 'ghostel--write-pty)
                 (lambda (term bytes) (push (list term bytes) seen))))
        (ghostel-send-key "up")
        (should (= 2 (length encoded)))
        (should (= 2 (length seen)))
        (should (= 2 (length (delete-dups (mapcar #'car seen)))))))))

(ert-deftest mux-paste-uses-each-terminal-encoder ()
  (ghostel-mux-test--with
    (ghostel-mux-new-session "one")
    (ghostel-mux-split-right)
    (ghostel-mux-toggle-sync)
    (let ((seen nil)
          (kill-ring '("è Unicode\nsecond line")))
      (cl-letf (((symbol-function 'ghostel--encode-paste)
                 (lambda (term text) (push (cons term text) seen))))
        (call-interactively #'ghostel-yank)
        (should (= 2 (length seen)))
        (should (= 2 (length (delete-dups (mapcar #'car seen)))))
        (should (cl-every (lambda (x) (equal (cdr x) "è Unicode\nsecond line")) seen))))))

