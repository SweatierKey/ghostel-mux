        (should (eq before (window-buffer (selected-window))))
        (should (ghostel-mux--pane-live-p p))
        (ghostel-mux "one")
        (should (eq p ghostel-mux--pane))))))

(ert-deftest mux-closing-pane-cleans-membership-and-renumbers-windows ()
  (ghostel-mux-test--with
    (let ((s (ghostel-mux-new-session "one")))
      (ghostel-mux-split-right)
      (let ((p ghostel-mux--pane))
        (ghostel-mux-kill-pane)
        (ghostel-mux--reconcile s)
        (should-not (buffer-live-p (ghostel-mux--pane-buffer p)))
        (should (= 1 (length (ghostel-mux--window-panes (ghostel-mux--current-window)))))
        (should (= 1 (length (window-list)))))
      (ghostel-mux-new-window)
      (let ((remaining (ghostel-mux--current-window)))
        (ghostel-mux-previous-window)
        (ghostel-mux-kill-window)
        (ghostel-mux--reconcile s)
        (should (= 1 (ghostel-mux--window-number remaining)))
        (should (eq remaining (ghostel-mux--current-window)))))))

