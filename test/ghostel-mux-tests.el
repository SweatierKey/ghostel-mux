(ert-deftest mux-move-pane-reparents-with-live-process-and-log ()
  (ghostel-mux-test--with
    (let* ((s1 (ghostel-mux-new-session "one")) (w1 (ghostel-mux--current-window))
           (p1 ghostel-mux--pane))
      (ghostel-mux-split-right)
      (let* ((p ghostel-mux--pane) (buf (current-buffer)) (proc (get-buffer-process buf))
             (id (ghostel-mux--pane-id p)) (log (ghostel-mux--pane-log-file p))
             (s2 (ghostel-mux-new-session "two")) (w2 (ghostel-mux--current-window))
             (other ghostel-mux--pane))
        (setf (ghostel-mux--window-sync w1) t (ghostel-mux--window-sync w2) t)
        (ghostel-mux-move-pane w2 p)
        (should (eq (ghostel-mux--pane-window p) w2))
        (should (equal (ghostel-mux--window-panes w1) (list p1)))
        (should (equal (ghostel-mux--window-panes w2) (list other p)))
        (should (eq (get-buffer-process buf) proc))
        (should (process-live-p proc))
        (should (= id (ghostel-mux--pane-id p)))
        (should (equal log (ghostel-mux--pane-log-file p)))
        (should (= 2 (ghostel-mux--buffer-number p)))
        (should (equal (buffer-name buf) "*mux:two:2*"))
        (should-not (ghostel-mux--window-sync w1))
        (should-not (ghostel-mux--window-sync w2))
        (ghostel-mux-toggle-sync)
        (ghostel-mux-test--send "printf 'MOVED_%s\\n' OK\n")
        (ghostel-mux-test--wait
         (lambda () (and (string-match-p "MOVED_OK" (ghostel-mux-test--text p))
                         (string-match-p "MOVED_OK" (ghostel-mux-test--text other)))))
        (should-not (string-match-p "MOVED_OK" (ghostel-mux-test--text p1)))
        (ghostel-mux--attach s1)
        (should (= 1 (length (window-list))))
        (should (eq p1 ghostel-mux--pane))
        (ghostel-mux--attach s2)
        (should (= 2 (length (window-list))))))))

