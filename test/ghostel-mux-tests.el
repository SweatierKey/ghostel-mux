(ert-deftest mux-legacy-creation-forces-fresh-buffer-and-restores-display ()
  (save-window-excursion
    (let ((before (current-buffer))
          (visible (window-buffer (selected-window)))
          created seen)
      (unwind-protect
          (cl-letf (((symbol-function 'ghostel-create) nil)
                    ((symbol-function 'ghostel)
                     (lambda (arg)
                       (setq seen (list arg ghostel-buffer-name)
                             created (generate-new-buffer ghostel-buffer-name))
                       (switch-to-buffer created)
                       created)))
            (should (eq (ghostel-mux--create-terminal "*legacy-test*") created))
            (should (equal seen '((4) "*legacy-test*")))
            (should (eq before (current-buffer)))
            (should (eq visible (window-buffer (selected-window)))))
        (when (buffer-live-p created) (kill-buffer created))))))

