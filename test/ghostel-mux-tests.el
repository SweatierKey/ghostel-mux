(ert-deftest mux-broadcast-marker-matches-delivery-and-pauses-with-local-input ()
  (ghostel-mux-test--with
    (ghostel-mux-new-session "foreign")
    (let ((foreign (current-buffer)))
      (ghostel-mux-new-session "one")
      (let ((first ghostel-mux--pane))
        (ghostel-mux-split-right)
        (ghostel-mux-split-below)
        (ghostel-mux-toggle-sync)
        (let* ((w (ghostel-mux--current-window))
               (source ghostel-mux--pane)
               (view (selected-window))
               (panes (ghostel-mux--window-panes w)) seen)
          (cl-letf (((symbol-function 'ghostel--write-pty)
                     (lambda (_term &rest _) (push ghostel-mux--pane seen))))
            (ghostel-mux-test--send "broadcast")
            (should (= 3 (length seen)))
            (dolist (p panes)
              (should (memq p seen))
              (should (ghostel-mux--sync-target-p p))
              (should (string-prefix-p " [S] " (ghostel-mux--header p))))
            (ghostel-mux-zoom)
            (setq seen nil)
            (ghostel-mux-test--send "zoom local")
            (should (equal seen (list source)))
            (should-not (cl-some #'ghostel-mux--sync-target-p panes))
            (ghostel-mux-zoom)
            (setq view (selected-window))
            (set-window-buffer (get-buffer-window (ghostel-mux--pane-buffer first)) (get-buffer-create "*scratch*"))
            (should-not (ghostel-mux--sync-target-p first))
            (should (ghostel-mux--sync-target-p source))
            (ghostel-mux-copy-mode)
            ;; Explicit paste can still broadcast from copy mode.
            (setq seen nil)
            (let ((kill-ring '("paste from copy mode")))
              (cl-letf (((symbol-function 'ghostel--encode-paste)
                         (lambda (&rest _) (push ghostel-mux--pane seen))))
                (ghostel-mux-paste)))
            (should (= 2 (length seen)))
            (dolist (p seen) (should (ghostel-mux--sync-target-p p)))
            (ghostel-mux-copy-exit)
            (set-window-buffer view foreign)
            (set-buffer foreign)
            (setq seen nil)
            (ghostel-mux-test--send "foreign local")
            (should (= 1 (length seen)))
            (should-not (cl-some #'ghostel-mux--sync-target-p panes))
            (should (ghostel-mux--window-sync w))))))))

(ert-deftest mux-marker-redisplay-uses-true-input-window-and-preserves-accent ()
