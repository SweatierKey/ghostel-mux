(ert-deftest mux-window-preview-cancel-keeps-origin-and-saved-window-selection ()
  (skip-unless (require 'consult nil t))
  (ghostel-mux-test--with
    (let* ((one (ghostel-mux-new-session "one"))
           (first (ghostel-mux--current-window)))
