(ert-deftest mux-recording-retains-raw-bytes-and-records-hidden-output ()
  (ghostel-mux-test--with
    (ghostel-mux-new-session "one")
    (let ((p ghostel-mux--pane))
      (ghostel-send-string "printf '\\033[31mRAW_%s\\033[0m\\n' MARKER\n")
      (ghostel-mux-new-window)
      (ghostel-mux-test--wait
       (lambda () (string-match-p "RAW_MARKER" (ghostel-mux-test--text p))))
      (ghostel-mux-flush-logs)
      (with-temp-buffer
        (insert-file-contents-literally (ghostel-mux--pane-log-file p))
        (should (string-match-p (regexp-quote "\e[31mRAW_MARKER\e[0m") (buffer-string))))
      (should (= #o600 (logand #o777 (file-modes (ghostel-mux--pane-log-file p))))))
    (should (cl-every (lambda (p)
                       (with-current-buffer (ghostel-mux--pane-buffer p)
                         (eq (process-type ghostel--process) 'real)))
                     (ghostel-mux--all-panes)))))

