(ert-deftest mux-window-transfer-layout-failure-is-inert ()
  (ghostel-mux-test--with
    (let* ((source (ghostel-mux-new-session "one")) (w (ghostel-mux--current-window))
           (target (ghostel-mux-new-session "two")))
      (setf (ghostel-mux--window-sync w) t)
      (cl-letf (((symbol-function 'window-state-put) (lambda (&rest _) (error "Frame too small"))))
        (should-error (ghostel-mux-move-window target w)))
      (should (eq source (ghostel-mux--window-session w)))
      (should (memq w (ghostel-mux--session-windows source)))
      (should (ghostel-mux--window-sync w))
      (should (= 1 (length (ghostel-mux--session-windows target)))))))

