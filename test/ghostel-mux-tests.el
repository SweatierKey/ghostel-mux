      (cl-letf (((symbol-function 'old-selected-window) (lambda () scratch))
                ((symbol-function 'mode-line-window-selected-p) (lambda () nil)))
        (should-not (string-match-p "\\[S\\]" (car (ghostel-mux--render 'header)))))
      (cl-letf (((symbol-function 'old-selected-window) (lambda () input))
                ((symbol-function 'mode-line-window-selected-p) (lambda () t)))
