(ert-deftest mux-copy-is-persistent-and-never-deletes-output ()
  (ghostel-mux-test--with
    (ghostel-mux-new-session "one")
    (ghostel-mux-copy-mode)
    (let ((inhibit-read-only t) (ghostel--inhibit-insert-forwarding t))
      (erase-buffer) (insert "alpha beta\ngamma\n"))
    (let ((original (buffer-string)) (transient-mark-mode t))
      (goto-char (point-min)) (push-mark (+ (point-min) 5) t t)
      (ghostel-mux-copy-selection)
      (should (equal (current-kill 0) "alpha"))
      (should (eq ghostel--input-mode 'copy))
      (should-not (region-active-p))
      (should (equal original (buffer-string)))
      (goto-char (point-min)) (push-mark (+ (point-min) 5) t t)
      (ghostel-mux-clear-selection)
      (should (eq ghostel--input-mode 'copy))
      (goto-char (point-min)) (push-mark (+ (point-min) 5) t t)
      (ghostel-mux-copy-selection-and-exit)
      (should (eq ghostel--input-mode 'semi-char)))))

