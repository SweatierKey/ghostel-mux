    (ghostel-mux-new-session "one")
    (let ((normal ghostel-mux--pane))
      (ghostel-send-string "printf '\\033[?1l'; stty raw -echo; printf 'NORMAL_%s\\n' READY; dd bs=1 count=3 2>/dev/null | od -An -tx1; stty sane\n")
      (ghostel-mux-split-right)
      (let ((application ghostel-mux--pane))
        (ghostel-send-string "printf '\\033[?1h'; stty raw -echo; printf 'APP_%s\\n' READY; dd bs=1 count=3 2>/dev/null | od -An -tx1; stty sane\n")
        (ghostel-mux-test--wait
         (lambda () (and (string-match-p "NORMAL_READY" (ghostel-mux-test--text normal))
                          (string-match-p "APP_READY" (ghostel-mux-test--text application)))))
        (ghostel-mux-toggle-sync)
        (let ((ghostel-mux--input-source (current-buffer))) (ghostel-send-key "up"))
        (ghostel-mux-test--wait
         (lambda () (and (string-match-p "1b 5b 41" (ghostel-mux-test--text normal))
                          (string-match-p "1b 4f 41" (ghostel-mux-test--text application)))))))))

