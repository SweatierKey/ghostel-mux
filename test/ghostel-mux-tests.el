(ert-deftest mux-tree-move-and-visit-restores-the-full-owning-layout ()
  (ghostel-mux-test--with
    (let* ((source (ghostel-mux-new-session "one")) (p ghostel-mux--pane)
           (target (ghostel-mux-new-session "two")) (w (ghostel-mux--current-window)))
